{
  "info": {
    "name": "md-to-tests",
    "description": "Генерация тест-кейсов в Markdown из raw MD или из pdf-to-md. Строгий формат TestCase (id, type, priority, preconditions, steps, expectedResult, requirementRef). Цикл уточнений через /answers. Защита от SSRF и path traversal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "pdfToMdBaseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "downloadUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "firstFilename",
      "value": "",
      "type": "string"
    },
    {
      "key": "firstArtifactId",
      "value": "",
      "type": "string",
      "description": "UUID первого файла генерации (последний сегмент files[].downloadUrl), используется в GET /api/files/{id}."
    },
    {
      "key": "journalEntryId",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string",
      "description": "UUID записи журнала для PUT и DELETE /api/journal/{id}."
    },
    {
      "key": "lastStatus",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Сгенерировать из raw Markdown",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has taskId', () => pm.expect(json.taskId).to.be.a('string').that.is.not.empty);",
              "pm.test('has files', () => pm.expect(json.files).to.be.an('array').that.is.not.empty);",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));",
              "",
              "// Сохраняем состояние для следующих шагов",
              "pm.collectionVariables.set('taskId', json.taskId);",
              "pm.collectionVariables.set('lastStatus', json.status);",
              "const mdFile = (json.files || []).find(f => f.id !== '_index' && f.id !== '_clarifications');",
              "if (mdFile) {",
              "  pm.collectionVariables.set('firstFilename', mdFile.filename);",
              "  pm.collectionVariables.set('firstArtifactId', mdFile.downloadUrl.split('/').pop());",
              "}",
              "",
              "// Строгий формат TestCase",
              "if (Array.isArray(json.testCases) && json.testCases.length > 0) {",
              "  const tc = json.testCases[0];",
              "  pm.test('id format', () => pm.expect(tc.id).to.match(/^TC-(UI|API|E2E|NEG|NEGATIVE|SEC|SECURITY|PERF|PERFORMANCE)-\\d{3,}$/));",
              "  pm.test('type valid', () => pm.expect(tc.type).to.be.oneOf(['UI','API','E2E','NEGATIVE','SECURITY','PERFORMANCE']));",
              "  pm.test('priority valid', () => pm.expect(tc.priority).to.be.oneOf(['P0','P1','P2','P3']));",
              "  pm.test('preconditions array', () => pm.expect(tc.preconditions).to.be.an('array'));",
              "  pm.test('steps non-empty', () => pm.expect(tc.steps).to.be.an('array').that.is.not.empty);",
              "  pm.test('expectedResult non-empty', () => pm.expect(tc.expectedResult).to.be.a('string').that.is.not.empty);",
              "  pm.test('requirementRef non-empty', () => pm.expect(tc.requirementRef).to.be.a('string').that.is.not.empty);",
              "}",
              "",
              "// Filenames должны соответствовать SAFE_NAME",
              "if (Array.isArray(json.files)) {",
              "  pm.test('all filenames safe', () => {",
              "    json.files.forEach(f => pm.expect(f.filename).to.match(/^[a-zA-Z0-9_\\-]+\\.md$/));",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"markdown\": \"# ТЗ\\n\\n## REQ-001 Логин\\nПользователь входит по email и паролю.\\n\\n## REQ-002 Создание заказа\\nТребуется указать адрес доставки.\\n\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate"
          ]
        },
        "description": "Принимает markdown напрямую. MD-файлы создаются всегда. Если status=NEEDS_CLARIFICATION — переходите к шагу 4."
      },
      "response": []
    },
    {
      "name": "2. Сгенерировать из pdf-to-md (pdfToMdUrl + filename)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has taskId', () => pm.expect(json.taskId).to.be.a('string').that.is.not.empty);",
              "pm.test('has files', () => pm.expect(json.files).to.be.an('array').that.is.not.empty);",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));",
              "",
              "// filename как префикс должен появиться в именах файлов",
              "if (Array.isArray(json.files) && json.files.length > 0) {",
              "  pm.test('files have prefix from filename', () => {",
              "    const hasPrefix = json.files.some(f => f.filename.startsWith('spec_'));",
              "    pm.expect(hasPrefix).to.be.true;",
              "  });",
              "}",
              "",
              "pm.collectionVariables.set('taskId', json.taskId);",
              "pm.collectionVariables.set('lastStatus', json.status);",
              "const mdFile = (json.files || []).find(f => f.id !== '_index' && f.id !== '_clarifications');",
              "if (mdFile) {",
              "  pm.collectionVariables.set('firstFilename', mdFile.filename);",
              "  pm.collectionVariables.set('firstArtifactId', mdFile.downloadUrl.split('/').pop());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pdfToMdUrl\": \"{{downloadUrl}}\",\n  \"filename\": \"spec.pdf\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate"
          ]
        },
        "description": "Скачивает .md из pdf-to-md по {{downloadUrl}} и генерирует тест-кейсы. filename используется как префикс файлов (spec_TC-UI-001_login.md). {{downloadUrl}} заполняется вручную или шагом 'A. Загрузить PDF в pdf-to-md'."
      },
      "response": []
    },
    {
      "name": "2a. SSRF: запрещённый хост → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const json = pm.response.json();",
              "pm.test('mentions host', () => pm.expect(json.message).to.include('Хост не разрешён'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pdfToMdUrl\": \"http://169.254.169.254/latest/meta-data\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate"
          ]
        },
        "description": "Проверяет SSRF-allowlist: запрос на чужой хост → 400."
      },
      "response": []
    },
    {
      "name": "2b. Пустой markdown → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"markdown\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate"
          ]
        },
        "description": "Пустой/пробельный markdown должен вернуть 400."
      },
      "response": []
    },
    {
      "name": "3. Некорректный ответ модели → 502",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 502 or 200', () => pm.expect(pm.response.code).to.be.oneOf([200, 502]));",
              "if (pm.response.code === 502) {",
              "  const json = pm.response.json();",
              "  pm.test('has error message', () => pm.expect(json.message).to.be.a('string').that.is.not.empty);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"markdown\": \"# Документ без требований\\n\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate"
          ]
        },
        "description": "Если модель вернёт JSON не по схеме — 502 с описанием. Допускается 200, если модель справилась."
      },
      "response": []
    },
    {
      "name": "4. Ответить на уточнения",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('lastStatus') === 'DONE') {",
              "  console.log('Skipping answers: status=DONE');",
              "  pm.execution.skipRequest();",
              "}",
              "if (!pm.collectionVariables.get('taskId')) {",
              "  console.log('Skipping answers: no taskId');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));",
              "pm.collectionVariables.set('lastStatus', json.status);",
              "if (json.status === 'DONE') {",
              "  pm.collectionVariables.unset('taskId');",
              "}",
              "",
              "if (Array.isArray(json.testCases) && json.testCases.length > 0) {",
              "  json.testCases.forEach(tc => {",
              "    pm.expect(tc.id).to.match(/^TC-(UI|API|E2E|NEG|NEGATIVE|SEC|SECURITY|PERF|PERFORMANCE)-\\d{3,}$/);",
              "    pm.expect(tc.priority).to.be.oneOf(['P0','P1','P2','P3']);",
              "    pm.expect(tc.preconditions).to.be.an('array');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"requirementRef\": \"REQ-001\", \"answer\": \"Логин: email, пароль минимум 8 символов\" },\n    { \"requirementRef\": \"REQ-002\", \"answer\": \"Адрес доставки обязателен\" }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate/{{taskId}}/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate",
            "{{taskId}}",
            "answers"
          ]
        },
        "description": "Отправляет ответы на clarifications. MD-файлы перезаписываются. Если status=DONE — сессия закрыта."
      },
      "response": []
    },
    {
      "name": "4a. Ответ на истёкшую сессию → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const json = pm.response.json();",
              "pm.test('mentions session', () => pm.expect(json.message).to.include('Сессия не найдена'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"requirementRef\": \"REQ-001\", \"answer\": \"x\" }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate/00000000-0000-0000-0000-000000000000/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generate",
            "00000000-0000-0000-0000-000000000000",
            "answers"
          ]
        },
        "description": "Несуществующий taskId → 400 'Сессия не найдена или истекла'."
      },
      "response": []
    },
    {
      "name": "4b. Состояние сессии уточнений",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has version', () => pm.expect(json.version).to.be.a('number'));",
              "pm.test('has answers array', () => pm.expect(json.answers).to.be.an('array'));",
              "pm.test('has draft object', () => pm.expect(json.draft).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/generate/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "generate", "{{taskId}}"]
        },
        "description": "Состояние сессии уточнений генерации из БД: status, version, round, clarifications, answers, draft. Срок хранения 30 дней; для истёкшей сессии → 400 «Сессия не найдена или истекла»."
      },
      "response": []
    },
    {
      "name": "4c. Черновик ответов",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"draft\":{\"0\":\"черновик ответа\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate/{{taskId}}/draft",
          "host": ["{{baseUrl}}"],
          "path": ["api", "generate", "{{taskId}}", "draft"]
        },
        "description": "Сохраняет черновик ответов на уточнения: draft перезаписывается целиком, version не меняется. Ответ 204."
      },
      "response": []
    },
    {
      "name": "4d. Ответ с устаревшей версией → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('mentions version conflict', () => pm.expect(pm.response.json().message).to.include('Сессия уже изменена'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"answers\":[{\"question\":\"x\",\"answer\":\"y\",\"topicKey\":\"z\"}],\"expectedVersion\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate/{{taskId}}/answers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "generate", "{{taskId}}", "answers"]
        },
        "description": "Передаёт expectedVersion=0, который не совпадает с текущей version сессии → 409 «Сессия уже изменена в другом окне. Обновите страницу.». Тест рассчитан на сессию с version больше 0."
      },
      "response": []
    },
    {
      "name": "5. Скачать MD-тест-кейс",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('firstArtifactId')) {",
              "  console.log('Skipping download: no artifactId');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('artifactId is UUID', () => pm.expect(pm.collectionVariables.get('firstArtifactId')).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
              "pm.test('content-type markdown', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/markdown'));",
              "pm.test('content-disposition attachment', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));",
              "pm.test('content-length present', () => pm.expect(pm.response.headers.get('Content-Length')).to.be.a('string'));",
              "",
              "const body = pm.response.text();",
              "pm.test('has Приоритет', () => pm.expect(body).to.include('**Приоритет:**'));",
              "pm.test('has Шаги', () => pm.expect(body).to.include('## Шаги'));",
              "pm.test('has Ожидаемый результат', () => pm.expect(body).to.include('## Ожидаемый результат'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/files/{{firstArtifactId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "{{firstArtifactId}}"
          ]
