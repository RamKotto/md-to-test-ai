    {
      "name": "Интеграция: PDF → pdf-to-md → md-to-tests",
      "item": [
        {
          "name": "A. Загрузить PDF в pdf-to-md",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.downloadUrl) {",
                  "  pm.collectionVariables.set('downloadUrl', json.downloadUrl);",
                  "  console.log('downloadUrl =', json.downloadUrl);",
                  "}",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has downloadUrl', () => pm.expect(json.downloadUrl).to.be.a('string').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/your/document.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{pdfToMdBaseUrl}}/api/convert",
              "host": [
                "{{pdfToMdBaseUrl}}"
              ],
              "path": [
                "api",
                "convert"
              ]
            },
            "description": "Шаг 1 интеграции: загружаем PDF в pdf-to-md. downloadUrl сохраняется в переменную {{downloadUrl}} для шага B."
          },
          "response": []
        },
        {
          "name": "B. Передать downloadUrl в md-to-tests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has files', () => pm.expect(json.files).to.be.an('array').that.is.not.empty);",
                  "",
                  "pm.collectionVariables.set('taskId', json.taskId);",
                  "pm.collectionVariables.set('lastStatus', json.status);",
                  "const mdFile = (json.files || []).find(f => f.id !== '_index' && f.id !== '_clarifications');",
                  "if (mdFile) {",
              "  pm.collectionVariables.set('firstFilename', mdFile.filename);",
              "  pm.collectionVariables.set('firstArtifactId', mdFile.downloadUrl.split('/').pop());",
              "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pdfToMdUrl\": \"{{downloadUrl}}\",\n  \"filename\": \"document.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "generate"
              ]
            },
            "description": "Шаг 2 интеграции: md-to-tests сам скачивает MD из pdf-to-md по {{downloadUrl}} и генерирует тест-кейсы. Хост downloadUrl должен быть в allowed-hosts."
          },
          "response": []
        }
      ]
    }
